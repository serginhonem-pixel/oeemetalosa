@echo off
REM Copie este arquivo para "credentials.local" (na mesma pasta scripts\)
REM e preencha com o email/senha da conta do Firebase usada para sincronizar.
REM O arquivo "credentials.local" NAO vai para o git (ja esta no .gitignore via *.local).
set "SYNC_EMAIL=seu-email@exemplo.com"
set "SYNC_SENHA=sua-senha-aqui"
